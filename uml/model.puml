@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

package model {

    ' Game mode chosen in the configuration screen
    enum GameMode <<enumerate>> {
        CLASSIC
        PACMAN
    }

    ' Observer pattern: the view is notified when the game changes
    interface GameObserver <<interface>> {
        + {abstract} onBoardUpdated()
        + {abstract} onGameOver(winnerName : String)
    }

    ' Main class of the model: manages the game and notifies the view
    class Game {
        - m_currentPlayerIndex : Integer
        - m_isFinished : Boolean
        - m_wallsPerPlayer : Integer
        - m_playerCount : Integer
        - m_computerOpponent : Boolean
        - m_pacmanLives : Integer
        - m_eatenPacGums : Integer
        + <<create>> Game(boardSize : Integer, wallsPerPlayer : Integer, mode : GameMode, playerCount : Integer, computerOpponent : Boolean)
        - initPlayers(boardSize : Integer, wallsPerPlayer : Integer)
        + addObserver(observer : GameObserver)
        + notifyBoardUpdated()
        + notifyGameOver(winnerName : String)
        + getCurrentPlayer() : Player
        + getBoard() : Board
        + getPlayers() : Player[*]
        + isFinished() : Boolean
        + moveCurrentPlayer(target : Position) : Boolean
        + placeWallForCurrentPlayer(wall : Wall) : Boolean
        - checkVictory(player : Player) : Boolean
        - nextTurn()
        + resetGame()
    }

    package board {

        ' Coordinates (x, y) of a cell or of a wall anchor
        class Position {
            - m_x : Integer
            - m_y : Integer
            + <<create>> Position(x : Integer, y : Integer)
            + getX() : Integer
            + getY() : Integer
            + isAdjacentTo(other : Position) : Boolean
            + equals(obj : Object) : Boolean
            + hashCode() : Integer
            + toString() : String
        }

        ' Wall of length 2 anchored at a position, horizontal or vertical
        class Wall {
            - m_isHorizontal : Boolean
            + <<create>> Wall(position : Position, isHorizontal : Boolean)
            + getPosition() : Position
            + isHorizontal() : Boolean
            + blocksPassage(from : Position, to : Position) : Boolean
            + overlapsWith(other : Wall) : Boolean
            + equals(obj : Object) : Boolean
            + hashCode() : Integer
        }

        ' Game board, with the breadth-first search (BFS) for the paths
        class Board {
            - m_size : Integer
            + <<create>> Board(size : Integer)
            + getSize() : Integer
            + isInside(pos : Position) : Boolean
            + getWalls() : Wall[*]
            + addWall(wall : Wall)
            + removeWall(wall : Wall)
            + canPlaceWall(newWall : Wall) : Boolean
            + canPass(from : Position, to : Position) : Boolean
            + getAccessibleNeighbors(current : Position) : Position[*]
            + getShortestPath(start : Position, goalCoordinate : Integer, goalAxis : GoalAxis) : Position[*]
            + getShortestPath(start : Position, exactTarget : Position) : Position[*]
            - findShortestPath(start : Position, goalCondition : Predicate) : Position[*]
            + hasPathToGoal(player : Player) : Boolean
        }
    }

    package players {

        ' Axis of the goal line of a player: a column (X) or a row (Y)
        enum GoalAxis <<enumerate>> {
            GOAL_X
            GOAL_Y
        }

        abstract class Player <<abstract>> {
            - m_name : String
            - m_remainingWalls : Integer
            - m_moveCount : Integer
            - m_goalCoordinate : Integer
            + <<create>> Player(name : String, startPos : Position, remainingWalls : Integer, goalCoordinate : Integer, goalAxis : GoalAxis)
            + getName() : String
            + getPosition() : Position
            + setPosition(position : Position)
            + getRemainingWalls() : Integer
            + decrementWalls()
            + getMoveCount() : Integer
            + incrementMoveCount()
            + getGoalCoordinate() : Integer
            + getGoalAxis() : GoalAxis
            + hasReachedGoal() : Boolean
            + {abstract} isBot() : Boolean
        }

        class HumanPlayer extends Player {
            + <<create>> HumanPlayer(name : String, startPos : Position, remainingWalls : Integer, goalCoordinate : Integer, goalAxis : GoalAxis)
            + isBot() : Boolean
        }

        class BotPlayer extends Player {
            + <<create>> BotPlayer(name : String, startPos : Position, remainingWalls : Integer, goalCoordinate : Integer, goalAxis : GoalAxis, strategy : BotStrategy)
            + setStrategy(strategy : BotStrategy)
            + computeNextTurn(game : Game)
            + isBot() : Boolean
        }

        ' Strategy pattern for the levels of the computer (E1, E2, E3)
        interface BotStrategy <<interface>> {
            + {abstract} executeTurn(bot : BotPlayer, game : Game)
        }

        class RandomBotStrategy implements BotStrategy {
            + <<create>> RandomBotStrategy()
            + executeTurn(bot : BotPlayer, game : Game)
        }

        class ShortestPathBotStrategy implements BotStrategy {
            + <<create>> ShortestPathBotStrategy()
            + executeTurn(bot : BotPlayer, game : Game)
        }
    }

    ' Relations inside the model
    Game "1" *--> "1\n -m_board" Board : manages >
    Game "1" *--> "2..4\n -m_players" Player : includes >
    Game "1" *--> "1\n -m_mode" GameMode : has >
    Game "1" o--> "*\n -m_observers" GameObserver : notifies >
    Game ..> HumanPlayer : <<instantiate>>

    Wall "1" *--> "1\n -m_position" Position : is anchored at >
    Board "1" *--> "*\n -m_walls" Wall : contains >
    Board "1" *--> "*\n -m_pacGums" Position : contains >
    Board ..> Player : <<use>>

    Player "1" *--> "1\n -m_position" Position : is located at >
    Player "1" *--> "1\n -m_goalAxis" GoalAxis : has >
    BotPlayer "1" o--> "0..1\n -m_strategy" BotStrategy : uses >
    BotPlayer ..> Game : <<use>>
}

@enduml
