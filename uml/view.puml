@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

' Swing parent classes, declared once outside the view package
class JFrame
class JPanel

package view {

    ' Main window: holds the screens and switches between them
    class QuoridorWindow {
        + {static} HOME : String
        + {static} CONFIG : String
        + {static} GAME : String
        + <<create>> QuoridorWindow(controller : GameController)
        + showPage(name : String)
        + getConfigPanel() : ConfigPanel
        + getGamePanel() : GamePanel
    }

    ' Colors shared by the whole view
    class Theme {
        + {static} getPawnColor(index : Integer) : Color
    }

    package screens {

        ' Home screen: play and quit buttons
        class HomePanel {
            + <<create>> HomePanel(controller : GameController)
            - createButton(buttonName : String) : JButton
            - createLabel(labelName : String) : JLabel
        }

        ' Configuration screen: game mode, grid size, walls, players, opponent
        class ConfigPanel {
            + <<create>> ConfigPanel(controller : GameController)
            - createSection(title : String, row : JPanel) : JPanel
            - createToggleButton(text : String) : JToggleButton
            - createButton(text : String) : JButton
            - updateColors(button : JToggleButton)
            - updateOptions()
            + getGridSize() : Integer
            + getWallCount() : Integer
            + getGameMode() : GameMode
            + getPlayerCount() : Integer
            + isComputerOpponent() : Boolean
        }

        ' Game screen: shows the board, redrawn after each move
        class GamePanel {
            + <<create>> GamePanel(controller : GameController)
            + setGame(game : Game)
            + onBoardUpdated()
            + onGameOver(winnerName : String)
        }

        ' Wall placement screen (to be completed)
        class PlacementPanel

        ' End of game screen (to be completed)
        class EndPanel
    }

    package components {

        ' Draws the board and converts the clicks into cells
        class BoardPanel {
            - {static} CELL : Integer
            - {static} GAP : Integer
            - {static} PAWN : Integer
            - {static} FRAME_MARGIN : Integer
            - {static} BOARD_MARGIN : Integer
            - {static} OFFSET : Integer
            - {static} FRAME_ARC : Integer
            - {static} BOARD_ARC : Integer
            - {static} CELL_ARC : Integer
            + <<create>> BoardPanel(controller : GameController)
            + setGame(game : Game)
            - getGridPixels() : Integer
            # paintComponent(g : Graphics)
            - drawFrame(g2 : Graphics2D)
            - drawBoard(g2 : Graphics2D)
            - drawCells(g2 : Graphics2D)
            - drawPawns(g2 : Graphics2D)
            - getCellAt(pixelX : Integer, pixelY : Integer) : Position
        }

        ' Shows the information of one player (to be completed)
        class PlayerInfoPanel
    }
}

' Inheritance from the Swing classes
QuoridorWindow --|> JFrame
HomePanel --|> JPanel
ConfigPanel --|> JPanel
GamePanel --|> JPanel
BoardPanel --|> JPanel
PlayerInfoPanel --|> JPanel
PlacementPanel --|> JPanel
EndPanel --|> JPanel

' Window and its screens
QuoridorWindow "1" *--> "1\n -m_homePanel" HomePanel : contains >
QuoridorWindow "1" *--> "1\n -m_configPanel" ConfigPanel : contains >
QuoridorWindow "1" *--> "1\n -m_gamePanel" GamePanel : contains >

' Screens and their components
GamePanel "1" *--> "1\n -m_boardPanel" BoardPanel : contains >
BoardPanel .> Theme : <<use>>

@enduml
