@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

class Main {
    + {static} main(args : String[*])
}

package model {
    class Game
    enum GameMode <<enumerate>> {
        CLASSIC
        PACMAN
    }
}

package controller {
    class GameController {
        + setWindow(quoridorWindow : QuoridorWindow)
        + play()
        + quit()
        + goHome()
        + startGame()
    }
}

package view {

    class QuoridorWindow extends JFrame {
        + {static} HOME : String
        + {static} CONFIG : String
        + {static} GAME : String
        + <<create>> QuoridorWindow(controller : GameController)
        + showPage(name : String)
        + getConfigPanel() : ConfigPanel
        + getGamePanel() : GamePanel
    }

    package screens {
        class HomePanel extends JPanel {
            + <<create>> HomePanel(controller : GameController)
            - createButton(buttonName : String) : JButton
            - createLabel(labelName : String) : JLabel
        }

        class ConfigPanel extends JPanel {
            + <<create>> ConfigPanel(controller : GameController)
            + getGridSize() : Integer
            + getWallCount() : Integer
            + getGameMode() : GameMode
            + getPlayerCount() : Integer
            + isComputerOpponent() : Boolean
            - createSection(title : String, row : JPanel) : JPanel
            - createToggleButton(text : String) : JToggleButton
            - createButton(text : String) : JButton
            - updateColors(button : JToggleButton)
            - updateOptions()
        }

        class GamePanel extends JPanel {
            + <<create>> GamePanel(controller : GameController)
            + setGame(game : Game)
        }

        class PlacementPanel extends JPanel
        class EndPanel extends JPanel
    }

    package components {
        class BoardPanel extends JPanel {
            - {static} CELL : Integer
            - {static} GAP : Integer
            - {static} PAWN : Integer
            - {static} FRAME_MARGIN : Integer
            - {static} BOARD_MARGIN : Integer
            - {static} OFFSET : Integer
            - {static} FRAME_ARC : Integer
            - {static} BOARD_ARC : Integer
            - {static} CELL_ARC : Integer
            + <<create>> BoardPanel()
            + setGame(game : Game)
            - getGridPixels() : Integer
            # paintComponent(g : Graphics)
            - drawFrame(g2 : Graphics2D)
            - drawBoard(g2 : Graphics2D)
            - drawCells(g2 : Graphics2D)
            - drawPawns(g2 : Graphics2D)
        }

        class PlayerInfoPanel extends JPanel
    }
}

' Creation of the application
Main .> GameController : <<instantiate>>
Main .> QuoridorWindow : <<instantiate>>

' Controller
GameController "1" o--> "1\n -quoridorWindow" QuoridorWindow : controls >
GameController "1" o--> "0..1\n -game" Game : plays >
GameController .> GameMode : <<use>>

' Window and its pages
QuoridorWindow "1" *--> "1\n -homePanel" HomePanel : contains >
QuoridorWindow "1" *--> "1\n -configPanel" ConfigPanel : contains >
QuoridorWindow "1" *--> "1\n -gamePanel" GamePanel : contains >
QuoridorWindow "1" *--> "1\n -placementPanel" PlacementPanel : contains >
QuoridorWindow "1" *--> "1\n -endPanel" EndPanel : contains >
QuoridorWindow .> GameController : <<use>>

' Pages
HomePanel .> GameController : <<call>>
ConfigPanel .> GameController : <<call>>
ConfigPanel .> GameMode : <<use>>
GamePanel "1" o--> "1\n -controller" GameController : notifies >
GamePanel "1" o--> "0..1\n -game" Game : displays >
GamePanel "1" *--> "1\n -boardPanel" BoardPanel : contains >
GamePanel "1" *--> "2..4\n -playerInfos" PlayerInfoPanel : contains >
PlacementPanel "1" *--> "1\n -boardPanel" BoardPanel : contains >

' Board
BoardPanel "1" o--> "0..1\n -game" Game : draws >

@enduml