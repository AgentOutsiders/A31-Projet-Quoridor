@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

package controller {

    ' Receives the view actions, creates and updates the game, and switches pages
    class GameController {
        + setWindow(quoridorWindow : QuoridorWindow)
        + play()
        + quit()
        + goHome()
        + startGame()
        + onCellClicked(position : Position)
        + onWallClicked(wall : Wall)
    }
}

@enduml
