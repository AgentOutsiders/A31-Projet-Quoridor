@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
hide empty members

package controller {

    ' Receives the user actions from the view and changes the displayed page
    ' (its window is shown by a relation in diagram.puml)
    class GameController {
        + setWindow(quoridorWindow : QuoridorWindow)
        + play()
        + quit()
    }
}

@enduml
