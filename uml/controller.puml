@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
hide empty members

package controller {

    ' Reçoit les actions de la vue, met à jour le modèle et pilote la navigation
    class GameController {
        + <<create>> GameController(game : Game)
        + setWindow(quoridorWindow : QuoridorWindow)
        + startNewGame(gridSize : Integer, wallsCount : Integer, isPacman : Boolean, vsBot : Boolean)
        + handleCellClick(x : Integer, y : Integer)
        + handleWallClick(x : Integer, y : Integer, isHorizontal : Boolean)
        + play()
        + restartGame()
        + quit()
    }
}

@enduml